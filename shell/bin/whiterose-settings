#!/bin/sh
# Opens WhiteRose Settings, at PAGE if given (network, sound, power, ...).
# If Settings is already open in this session it just goes to that page:
# there's only ever one per session.
dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cfg="$dir/settings.qml"
# This session's running Settings, found by its command line (QuickShell's
# own lookup by config path isn't reliable) and its Wayland display, so a
# Settings open in another session (a nested test one) doesn't count.
pid=""
for p in $(pgrep -u "$(id -u)" -f "^qs -p $cfg( |\$)"); do
    if tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -qx "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"; then
        pid="$p"
    fi
done
if [ -n "$pid" ]; then
    [ -n "$1" ] && qs ipc --pid "$pid" call settings open "$1" >/dev/null 2>&1
    exit 0
fi
# Settings draws its own window frame (WhiteRose has no server-side ones).
QT_WAYLAND_DISABLE_WINDOWDECORATION=1 WHITEROSE_SETTINGS_PAGE="$1" exec qs -p "$cfg"
