[Desktop Entry]
Name=Notepad
GenericName=Text Editor
Comment=Notes and text files, with an always-there scratch note
Exec=whiterose-notepad %F
Icon=whiterose-notepad
Terminal=false
Type=Application
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-markdown;application/x-shellscript;text/x-script.python;text/x-python;text/x-rust;text/x-go;text/x-c;text/x-c++src;text/x-chdr;application/json;application/x-yaml;application/toml;text/x-makefile;text/x-log;
Keywords=text;editor;notes;scratch;code;
StartupNotify=true
