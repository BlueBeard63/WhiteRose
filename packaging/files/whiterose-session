#!/bin/sh
# Starts a WhiteRose session (the login screen's "WhiteRose" entry, or
# `whiterose-session` from a text console).
export XDG_CURRENT_DESKTOP=WhiteRose
export XDG_SESSION_DESKTOP=whiterose
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
# The version to run (/usr/lib/whiterose/<version>): everything in the
# session uses it, whatever newer one gets installed meanwhile.
WHITEROSE_DIR=$(/usr/lib/whiterose/select) || exit 1
export WHITEROSE_DIR
# Its own programs first (WhiteRose's QuickShell, pinned to its Qt).
export PATH="$WHITEROSE_DIR/bin:$PATH"

# The terminal SUPER+RETURN opens: $TERMINAL, else the first one installed.
if [ -z "$TERMINAL" ]; then
    for t in ghostty ptyxis gnome-terminal konsole foot xterm; do
        if command -v "$t" >/dev/null 2>&1; then
            case "$t" in ptyxis) TERMINAL="ptyxis --standalone" ;; *) TERMINAL="$t" ;; esac
            break
        fi
    done
fi
export TERMINAL

# Apps started by D-Bus and systemd (portals, the file chooser) need to find
# this session's display.
exec whiterose-wm --backend drm \
    --daemon "whiterosed serve" \
    --shell "qs -p $WHITEROSE_DIR/shell" \
    -c "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE"
