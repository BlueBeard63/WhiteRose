#!/bin/sh
# Starts a WhiteRose session (the login screen's "WhiteRose" entry, or
# `whiterose-session` from a text console).
export XDG_CURRENT_DESKTOP=WhiteRose
export XDG_SESSION_DESKTOP=whiterose
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
# The terminal SUPER+RETURN opens: $TERMINAL, else the first one installed.
if [ -z "$TERMINAL" ]; then
    for t in ghostty ptyxis gnome-terminal konsole foot xterm; do
        if command -v "$t" >/dev/null 2>&1; then
            case "$t" in ptyxis) TERMINAL="ptyxis --standalone" ;; *) TERMINAL="$t" ;; esac
            break
        fi
    done
fi
export TERMINAL

# The version to run (/usr/lib/whiterose/<version>; a new one is tried with
# a health check, going back if it doesn't come up), then the session.
exec /usr/lib/whiterose/launch
