[Desktop Entry]
Name=Files
GenericName=File Manager
Comment=Browse and organise your files
Exec=whiterose-files %U
Icon=whiterose-files
Terminal=false
Type=Application
Categories=System;FileTools;FileManager;Utility;Core;
MimeType=inode/directory;x-scheme-handler/trash;
Keywords=files;folders;browse;explorer;manager;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=whiterose-files
