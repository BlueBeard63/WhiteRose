<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WhiteRose</vendor>
  <action id="org.whiterose.apps.install">
    <description>Install apps</description>
    <message>Installing apps needs your password</message>
    <icon_name>system-software-install</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/whiterosed</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">apps-root</annotate>
  </action>
  <action id="org.whiterose.fingerprint.login">
    <description>Use fingerprints to sign in</description>
    <message>Changing how everyone signs in needs your password</message>
    <icon_name>fingerprint</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/whiterosed</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">fingerprint-root</annotate>
  </action>
  <action id="org.whiterose.update.install">
    <description>Install WhiteRose updates</description>
    <message>Installing the WhiteRose update needs your password</message>
    <icon_name>system-software-update</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/whiterosed</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">update-root</annotate>
  </action>
</policyconfig>
