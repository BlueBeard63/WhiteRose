# Build environment for the .deb (Ubuntu 26.04: the Qt it links against).
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential cmake ninja-build pkg-config dpkg-dev \
    qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev \
    qt6-wayland-dev qt6-wayland-private-dev qt6-shadertools-dev qt6-svg-dev spirv-tools \
    libcli11-dev libdrm-dev libgbm-dev libjemalloc-dev libpipewire-0.3-dev libpam0g-dev \
    libpolkit-agent-1-dev libpolkit-gobject-1-dev libglib2.0-dev libwayland-dev wayland-protocols \
    libxkbcommon-dev libinput-dev libseat-dev libudev-dev libegl-dev libgles-dev \
    && rm -rf /var/lib/apt/lists/*
ARG GO_VERSION=1.26.8
RUN curl -fsSL https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz | tar -C /usr/local -xz
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:/usr/local/go/bin:$PATH
