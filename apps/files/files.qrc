<!DOCTYPE RCC><RCC version="1.0">
<qresource prefix="/qt/qml/WhiteRose/Files">
    <file>qml/Format.js</file>
    <file>qml/Tabs.js</file>
    <file>qml/Drops.js</file>
    <file>qml/Layout.js</file>
    <file>qml/Arrange.js</file>
    <!-- The shortcut list, shared with Settings › Files › Shortcuts. -->
    <file alias="qml/FilesKeys.js">../../shell/settings/modules/files/FilesKeys.js</file>
    <!-- Loaded only when needed, so not compiled ahead: they need Qt
         modules that may not be installed. -->
    <file>qml/MediaPreview.qml</file>
    <file>qml/PdfPreview.qml</file>
    <!-- WhiteRose's rose (packaging/branding/whiterose.png, small): Start. -->
    <file>images/whiterose.png</file>
</qresource>
</RCC>
